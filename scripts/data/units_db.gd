## —— QTE 可调旋钮（对应 GDD/04 战斗系统 与 GDD/06 数值方法论）——
const QTE := {
	# 完美防御反弹倍率：反弹伤害 = 主角防御力 x 此系数。
	# GDD 定的范围是 1.2~2.0，先取 1.6 中间值，模拟/试玩后调。
	"counter_mult": 1.6,

	# 闪避反击倍率（2026-11-07 用户实测"闪避完全没防御收益高"后新增）：
	# 闪避成功 = 完全回避 + 反击 主角攻击力 x 此系数（无视目标防御）。
	# 窗口与完美防御一样窄（0.05），但收益更高、失败更惨——进攻位的赌博。
	# 反击 54 vs 完美防御反弹 48（Lv6）：攻击成长越高闪避越香。
	"dodge_counter_mult": 1.2,

	# 血瓶一次回复量（灰盒先给主角随身 3 瓶）
	"potion_heal": 60,
	"potion_start": 3,
}


